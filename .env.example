# Copy this file to ".env" and fill in the values.

PORT=3000

# Password for the admin page (/kingalok). Use something long.
ADMIN_PASSWORD=12345678
# Random secret for signing admin login cookies (any long random text)
SESSION_SECRET=replace-with-a-long-random-string

# Local only: folder where orders are saved on your computer
DATA_DIR=./data

# Vercel only: added automatically when you connect Upstash Redis in Vercel → Storage.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
