# Copy this file to ".env" and fill in the values.

PORT=3000

# Public address of the site (no trailing slash)
SITE_URL=http://localhost:3000

# Password for the /admin page. Use something long.
ADMIN_PASSWORD=12345678
# Random secret for signing admin login cookies (any long random text)
SESSION_SECRET=replace-with-a-long-random-string

# Folder where orders are saved (keep this on a persistent disk when hosting)
DATA_DIR=./data
